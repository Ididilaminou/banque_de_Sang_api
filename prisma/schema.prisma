// Schéma Prisma : la "carte" de la base MySQL.
// Les modèles et attributs métier sont nommés en français.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  DONNEUR
  PERSONNEL_BANQUE
  PERSONNEL_HOPITAL
  ADMINISTRATEUR
}

enum GroupeSanguin {
  A
  B
  AB
  O
}

enum Rhesus {
  POSITIF
  NEGATIF
}

enum TypeEtablissement {
  BANQUE_SANG
  HOPITAL
}

enum StatutEtablissement {
  EN_ATTENTE
  AUTORISE
  SUSPENDU
}

model Utilisateur {
  identifiant       Int      @id @default(autoincrement())
  courriel          String   @unique @db.VarChar(255)
  motDePasseHash    String   @db.VarChar(255)
  prenom            String   @db.VarChar(100)
  nom               String   @db.VarChar(100)
  telephone         String?  @db.VarChar(30)
  role              Role     @default(DONNEUR)
  estActif          Boolean  @default(true)
  doitChangerMotDePasse Boolean @default(false)
  dateCreation      DateTime @default(now())
  dateModification  DateTime @updatedAt

  donneur           Donneur?
  activationCompte  ActivationCompte?

  @@map("utilisateurs")
}

model Donneur {
  identifiant              Int           @id @default(autoincrement())
  utilisateurIdentifiant   Int           @unique
  groupeSanguin            GroupeSanguin
  rhesus                   Rhesus
  estDisponible            Boolean       @default(false)
  dateDerniereDisponibilite DateTime?
  dateCreation             DateTime      @default(now())
  dateModification         DateTime      @updatedAt
  dons                     Don[]

  utilisateur              Utilisateur   @relation(fields: [utilisateurIdentifiant], references: [identifiant], onDelete: Cascade)

  @@map("donneurs")
}

enum StatutDon {
  ENREGISTRE
  VALIDE
  ANNULE
}

model Don {
  identifiant            Int       @id @default(autoincrement())
  donneurIdentifiant     Int
  dateDon                DateTime
  volumeMillilitres      Int
  statut                 StatutDon @default(ENREGISTRE)
  commentaire            String?   @db.VarChar(500)
  dateCreation           DateTime  @default(now())
  dateModification       DateTime  @updatedAt

  donneur                Donneur   @relation(fields: [donneurIdentifiant], references: [identifiant], onDelete: Cascade)

  @@index([donneurIdentifiant, dateDon])
  @@map("dons")
}

model Etablissement {
  identifiant       Int                  @id @default(autoincrement())
  nom               String               @db.VarChar(150)
  type              TypeEtablissement
  adresse           String               @db.VarChar(255)
  ville             String               @db.VarChar(100)
  telephone         String?              @db.VarChar(30)
  courriel          String               @unique @db.VarChar(255)
  statut            StatutEtablissement @default(EN_ATTENTE)
  dateCreation      DateTime             @default(now())
  dateModification  DateTime             @updatedAt
  stocks            Stock[]
  demandesEmises    DemandeSang[]       @relation("EtablissementDemandeur")
  demandesRecues    DemandeSang[]       @relation("EtablissementDestinataire")

  @@map("etablissements")
}

enum StatutDemandeSang {
  EN_ATTENTE
  EN_COURS
  ACCEPTEE
  REJETEE
  LIVREE
  ANNULEE
}

model DemandeSang {
  identifiant                    Int                @id @default(autoincrement())
  etablissementDemandeurId      Int
  etablissementDestinataireId   Int?
  produit                       TypeProduitSanguin
  groupeSanguin                 GroupeSanguin
  rhesus                        Rhesus
  quantite                      Int
  urgence                       Boolean            @default(false)
  motif                         String             @db.VarChar(500)
  statut                        StatutDemandeSang  @default(EN_ATTENTE)
  dateCreation                  DateTime           @default(now())
  dateModification              DateTime           @updatedAt

  etablissementDemandeur        Etablissement      @relation("EtablissementDemandeur", fields: [etablissementDemandeurId], references: [identifiant])
  etablissementDestinataire     Etablissement?     @relation("EtablissementDestinataire", fields: [etablissementDestinataireId], references: [identifiant])

  @@index([statut, urgence])
  @@map("demandes_sang")
}

enum TypeProduitSanguin {
  SANG_TOTAL
  GLOBULES_ROUGES
  PLAQUETTES
  PLASMA
}

model Stock {
  identifiant          Int                 @id @default(autoincrement())
  etablissementIdentifiant Int
  produit              TypeProduitSanguin
  groupeSanguin        GroupeSanguin
  rhesus               Rhesus
  quantite             Int                 @default(0)
  seuilAlerte          Int                 @default(5)
  dateCreation         DateTime            @default(now())
  dateModification     DateTime            @updatedAt

  etablissement        Etablissement      @relation(fields: [etablissementIdentifiant], references: [identifiant], onDelete: Cascade)

  @@unique([etablissementIdentifiant, produit, groupeSanguin, rhesus])
  @@index([groupeSanguin, rhesus, produit])
  @@map("stocks")
}

model ActivationCompte {
  identifiant             Int         @id @default(autoincrement())
  utilisateurIdentifiant  Int         @unique
  codeHash                String      @db.VarChar(64)
  dateExpiration          DateTime
  estUtilise              Boolean     @default(false)
  dateUtilisation         DateTime?
  dateCreation            DateTime    @default(now())

  utilisateur             Utilisateur @relation(fields: [utilisateurIdentifiant], references: [identifiant], onDelete: Cascade)

  @@map("activations_comptes")
}
