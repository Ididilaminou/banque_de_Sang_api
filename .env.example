# Copie ce fichier vers .env et remplis tes vraies valeurs.
# Ne commite JAMAIS le fichier .env (il contient des secrets).

PORT=3000

# Format Prisma / MySQL :
# mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# XAMPP : utilisateur root, mot de passe souvent vide (rien entre : et @)
DATABASE_URL="mysql://root:@localhost:3306/banque_sang"

# Secret pour signer les tokens JWT (étape authentification).
# En production : une longue chaîne aléatoire, jamais partagée.
JWT_SECRET="change-moi-par-une-chaine-secrete"
JWT_EXPIRES_IN="1d"

# Clé secrète utilisée une seule fois pour créer le premier administrateur.
CLE_INSTALLATION="remplace-cette-valeur-par-une-longue-cle-secrete"

# Configuration Gmail SMTP : utiliser un mot de passe d'application.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_UTILISATEUR="ton-adresse@gmail.com"
SMTP_MOT_DE_PASSE="mot-de-passe-d-application-gmail"
ADRESSE_EXPEDITEUR="ton-adresse@gmail.com"
URL_APPLICATION="http://localhost:3000"
