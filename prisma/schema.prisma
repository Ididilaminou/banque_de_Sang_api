// Schéma Prisma : la "carte" de la base MySQL.
// Les modèles et attributs métier sont nommés en français.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  DONNEUR
  PERSONNEL_BANQUE
  PERSONNEL_HOPITAL
  ADMINISTRATEUR
}

enum GroupeSanguin {
  A
  B
  AB
  O
}

enum Rhesus {
  POSITIF
  NEGATIF
}

enum TypeEtablissement {
  BANQUE_SANG
  HOPITAL
}

enum StatutEtablissement {
  EN_ATTENTE
  AUTORISE
  SUSPENDU
}

model Utilisateur {
  identifiant       Int      @id @default(autoincrement())
  courriel          String   @unique @db.VarChar(255)
  motDePasseHash    String   @db.VarChar(255)
  prenom            String   @db.VarChar(100)
  nom               String   @db.VarChar(100)
  telephone         String?  @db.VarChar(30)
  role              Role     @default(DONNEUR)
  estActif          Boolean  @default(true)
  doitChangerMotDePasse Boolean @default(false)
  dateCreation      DateTime @default(now())
  dateModification  DateTime @updatedAt

  donneur           Donneur?
  activationCompte  ActivationCompte?

  @@map("utilisateurs")
}

model Donneur {
  identifiant              Int           @id @default(autoincrement())
  utilisateurIdentifiant   Int           @unique
  groupeSanguin            GroupeSanguin
  rhesus                   Rhesus
  estDisponible            Boolean       @default(false)
  dateDerniereDisponibilite DateTime?
  dateCreation             DateTime      @default(now())
  dateModification         DateTime      @updatedAt

  utilisateur              Utilisateur   @relation(fields: [utilisateurIdentifiant], references: [identifiant], onDelete: Cascade)

  @@map("donneurs")
}

model Etablissement {
  identifiant       Int                  @id @default(autoincrement())
  nom               String               @db.VarChar(150)
  type              TypeEtablissement
  adresse           String               @db.VarChar(255)
  ville             String               @db.VarChar(100)
  telephone         String?              @db.VarChar(30)
  courriel          String               @unique @db.VarChar(255)
  statut            StatutEtablissement @default(EN_ATTENTE)
  dateCreation      DateTime             @default(now())
  dateModification  DateTime             @updatedAt

  @@map("etablissements")
}

model ActivationCompte {
  identifiant             Int         @id @default(autoincrement())
  utilisateurIdentifiant  Int         @unique
  codeHash                String      @db.VarChar(64)
  dateExpiration          DateTime
  estUtilise              Boolean     @default(false)
  dateUtilisation         DateTime?
  dateCreation            DateTime    @default(now())

  utilisateur             Utilisateur @relation(fields: [utilisateurIdentifiant], references: [identifiant], onDelete: Cascade)

  @@map("activations_comptes")
}
